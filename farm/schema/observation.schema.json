{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldwatch.local/schema/observation.json",
  "title": "Fieldwatch farm observation",
  "description": "One hear from one station. Listener coordinates only unless the packet advertised a fix. Aligns with Fieldwatch 1.1.16 export fields.",
  "type": "object",
  "required": ["v", "station_id", "heard_at", "radio", "rssi"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "station_id": { "type": "string", "minLength": 2, "maxLength": 32 },
    "heard_at": { "type": "string", "format": "date-time" },
    "radio": { "type": "string", "enum": ["wifi_ap", "wifi_mgmt", "ble_adv", "remote_id", "heartbeat"] },
    "mac": { "type": "string", "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$" },
    "mac_kind": { "type": "string", "enum": ["public", "random", "unknown"] },
    "rssi": { "type": "integer", "minimum": -120, "maximum": 0 },
    "channel": { "type": "integer", "minimum": 0, "maximum": 233 },
    "freq_mhz": { "type": "integer", "minimum": 0, "maximum": 7200 },
    "name": { "type": "string", "maxLength": 32 },
    "mode": { "type": "string", "enum": ["ap_scan", "monitor", "ble_scan"] },
    "oui": { "type": "string", "maxLength": 32 },
    "signature_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "signature_names": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "extra_attention": { "type": "boolean" },
    "extra_attention_families": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "service_uuid": { "type": "string", "maxLength": 8 },
    "service_data_hex": { "type": "string", "maxLength": 64 },
    "vendor_ie_oui": { "type": "string", "maxLength": 12 },
    "dult_network_id": { "type": "integer", "minimum": 0, "maximum": 255 },
    "dult_mode": { "type": "string", "enum": ["near_owner", "separated"] },
    "find_hub_mode": { "type": "string", "enum": ["nearby", "separated"] },
    "uas_id": { "type": "string", "maxLength": 24 },
    "rid_status": { "type": "string", "enum": ["undeclared", "ground", "airborne", "emergency", "rid_failure"] },
    "rid_heading_deg": { "type": "number", "minimum": 0, "maximum": 360 },
    "rid_hspeed_mps": { "type": "number", "minimum": 0 },
    "payload_lat": { "type": "number" },
    "payload_lon": { "type": "number" },
    "payload_op_lat": { "type": "number" },
    "payload_op_lon": { "type": "number" },
    "payload_alt_m": { "type": "number" },
    "station_lat": { "type": "number" },
    "station_lon": { "type": "number" },
    "station_vbat_mv": { "type": "integer", "minimum": 0, "maximum": 50000 },
    "station_solar_mv": { "type": "integer", "minimum": 0, "maximum": 50000 }
  }
}
